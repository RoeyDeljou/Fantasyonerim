{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci -w @fant/web --include-workspace-root",
  "buildCommand": "npx tsc -b packages/shared && npm run build -w @fant/web",
  "outputDirectory": "apps/web/out",
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/media/:path*",
      "destination": "https://f003.backblazeb2.com/file/fantasyonerim-media/:path*"
    },
    {
      "source": "/fplimg/:path*",
      "destination": "https://resources.premierleague.com/:path*"
    },
    {
      "source": "/cdn/v1/config",
      "destination": "https://fantasyonerim-api.onrender.com/v1/config"
    },
    {
      "source": "/cdn/v1/config/",
      "destination": "https://fantasyonerim-api.onrender.com/v1/config"
    },
    {
      "source": "/cdn/v1/fpl/bootstrap",
      "destination": "https://fantasyonerim-api.onrender.com/v1/fpl/bootstrap"
    },
    {
      "source": "/cdn/v1/fpl/bootstrap/",
      "destination": "https://fantasyonerim-api.onrender.com/v1/fpl/bootstrap"
    },
    {
      "source": "/cdn/v1/league/avatars",
      "destination": "https://fantasyonerim-api.onrender.com/v1/league/avatars"
    },
    {
      "source": "/cdn/v1/league/avatars/",
      "destination": "https://fantasyonerim-api.onrender.com/v1/league/avatars"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fplimg/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, s-maxage=2592000, immutable"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=2592000, immutable"
        },
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        }
      ]
    },
    {
      "source": "/media/uploads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=300"
        },
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        }
      ]
    },
    {
      "source": "/media/((?!uploads/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, s-maxage=2592000, immutable"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=2592000, immutable"
        },
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        }
      ]
    },
    {
      "source": "/cdn/v1/config",
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=30, stale-while-revalidate=60"
        },
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        }
      ]
    },
    {
      "source": "/cdn/v1/config/",
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=30, stale-while-revalidate=60"
        },
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        }
      ]
    },
    {
      "source": "/cdn/v1/fpl/bootstrap",
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=60, stale-while-revalidate=300"
        },
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        }
      ]
    },
    {
      "source": "/cdn/v1/fpl/bootstrap/",
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=60, stale-while-revalidate=300"
        },
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        }
      ]
    },
    {
      "source": "/cdn/v1/league/avatars",
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=60, stale-while-revalidate=120"
        },
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        }
      ]
    },
    {
      "source": "/cdn/v1/league/avatars/",
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=60, stale-while-revalidate=120"
        },
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        }
      ]
    },
    {
      "source": "/handoff/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
