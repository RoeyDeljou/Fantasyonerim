# apps/api environment. Copy to apps/api/.env for local dev (loaded by `npm run dev`).

NODE_ENV=development
DATABASE_URL=postgresql://fant:fant@localhost:5432/fantasyonerim
# Used by the API test suite (wiped between tests!). Defaults to the URL below when unset.
TEST_DATABASE_URL=postgresql://fant:fant@localhost:5432/fantasyonerim_test

PORT=4000
HOST=0.0.0.0
# Comma-separated browser origins allowed by CORS. "*" is refused when NODE_ENV=production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# true behind a reverse proxy (Render) so rate limits see the real client IP.
TRUST_PROXY=false
LOG_LEVEL=info

# live = fantasy.premierleague.com, demo = bundled demo data (offline sandboxes / previews).
FPL_MODE=live
# Optional custom User-Agent for FPL requests.
FPL_USER_AGENT=

# First admin, created on startup if this username doesn't exist yet (never overwritten).
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-please

# 32 random bytes, base64 (`openssl rand -base64 32`). REQUIRED in production: encrypts recovery codes
# and (later) social tokens at rest. Changing it makes stored secrets unreadable.
SECRETS_KEY=
# Shared secret for POST /internal/jobs/tick (header x-cron-secret; external cron). Min 16 chars. REQUIRED in production.
CRON_SECRET=

# ---------- Phase 2: News feed, integrations, push ----------
# Public base URL of THIS API (Instagram OAuth redirect = $API_PUBLIC_URL/v1/integrations/instagram/callback,
# local media URLs). REQUIRED in production.
API_PUBLIC_URL=http://localhost:4000
# Public base URL of the web app (the Instagram OAuth callback redirects to $WEB_APP_URL/admin/). REQUIRED in production.
WEB_APP_URL=http://localhost:3000
# In-process job scheduler (every 30 s while awake). The cron tick endpoint works regardless.
JOBS_ENABLED=true

# Web push (VAPID). Generate with `npm run vapid -w @fant/api`. All three together; REQUIRED in production.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact for the push services.
VAPID_SUBJECT=mailto:admin@example.com

# Meta app (Facebook Login for Business) for "Connect Instagram". Both or neither.
META_APP_ID=
META_APP_SECRET=

# Re-hosted media (Instagram CDN URLs expire). local = files in MEDIA_DIR served at /media/* (dev only).
# Production MUST use s3 (Render's disk is ephemeral) — e.g. Cloudflare R2.
MEDIA_STORE=local
MEDIA_DIR=./.media
# S3-compatible storage, all required when MEDIA_STORE=s3. R2: https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL of the bucket (R2 public bucket / custom domain), e.g. https://media.example.com
S3_PUBLIC_BASE_URL=
