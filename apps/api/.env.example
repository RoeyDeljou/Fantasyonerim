# apps/api environment. Copy to apps/api/.env for local dev (loaded by `npm run dev`).

NODE_ENV=development
DATABASE_URL=postgresql://fant:fant@localhost:5432/fantasyonerim
# Used by the API test suite (wiped between tests!). Defaults to the URL below when unset.
TEST_DATABASE_URL=postgresql://fant:fant@localhost:5432/fantasyonerim_test

PORT=4000
HOST=0.0.0.0
# Comma-separated browser origins allowed by CORS. "*" is refused when NODE_ENV=production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# true behind a reverse proxy (Render) so rate limits see the real client IP.
TRUST_PROXY=false
LOG_LEVEL=info

# live = fantasy.premierleague.com, demo = bundled demo data (offline sandboxes / previews).
FPL_MODE=live
# Optional custom User-Agent for FPL requests.
FPL_USER_AGENT=

# First admin, created on startup if this username doesn't exist yet (never overwritten).
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-please

# 32 random bytes, base64 (`openssl rand -base64 32`). REQUIRED in production: encrypts recovery codes
# and (later) social tokens at rest. Changing it makes stored secrets unreadable.
SECRETS_KEY=
# Shared secret for POST /internal/jobs/tick (Phase 2 external cron). Min 16 chars.
CRON_SECRET=
