// Fantasyonerim API — Postgres schema.
// Migrations: `npm run prisma:migrate -w @fant/api` (dev) / `prisma migrate deploy` (prod + tests).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum CaptainBattleEntrySource {
  PLAYER
  ENTRY
}

enum CaptainBattleEntryKind {
  COMMUNITY
  CUSTOM
}

model User {
  id               String    @id @default(cuid())
  name             String
  /// FPL Team ID. Null only for admin-only accounts. One account per team.
  entryId          Int?      @unique
  teamName         String?
  role             Role      @default(USER)
  /// "he" | "en" (validated with LocaleSchema on read).
  locale           String    @default("he")
  /// argon2id hash of the normalized recovery code (verification).
  recoveryCodeHash String?
  /// AES-256-GCM ciphertext of the recovery code (so Profile can show it). Never logged.
  recoveryCodeEnc  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  bannedAt         DateTime?
  /// Shown to admins only. Set together with bannedAt.
  banReason        String?

  sessions          Session[]
  adminCredential   AdminCredential?
  pushSubscriptions PushSubscription[]
  nativePushDevices NativePushDevice[]
  notificationPrefs NotificationPrefs?
  notificationLogs  NotificationLog[]
  posts             CommunityPost[]
  comments          Comment[]
  likes             PostLike[]
  uploads           Upload[]
  reports           Report[]
  blocking          UserBlock[]        @relation("blocker")
  blockedBy         UserBlock[]        @relation("blocked")
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  /// SHA-256 (hex) of the opaque bearer token. The token itself is never stored.
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AdminCredential {
  id           String   @id @default(cuid())
  username     String   @unique
  /// argon2id
  passwordHash String
  userId       String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Singleton row (id = 1).
model AppSettings {
  id                      Int      @id @default(1)
  leagueId                Int?
  leagueName              String?
  deadlineReminderMinutes Int[]    @default([1440, 120])
  spotifyUrl              String?
  appleUrl                String?
  instagramUrl            String?
  xUrl                    String?
  whatsappUrl             String?
  updatedAt               DateTime @updatedAt
}

model CaptainBattle {
  id        String   @id @default(cuid())
  event     Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries CaptainBattleEntry[]

  @@index([updatedAt])
}

model CaptainBattleEntry {
  id       String                   @id @default(cuid())
  battleId String
  order    Int
  label    String
  kind     CaptainBattleEntryKind
  /// PLAYER: hand-picked `playerId`. ENTRY: linked FPL team `entryId` (captain read from its picks).
  /// DB CHECK "CaptainBattleEntry_source_target_check" enforces exactly one of them per source.
  source   CaptainBattleEntrySource @default(PLAYER)
  playerId Int?
  entryId  Int?

  battle CaptainBattle @relation(fields: [battleId], references: [id], onDelete: Cascade)

  @@unique([battleId, order])
}

// ---------- Phase 2: News, integrations, push, jobs ----------

enum IntegrationId {
  podcast_rss
  spotify
  apple
  instagram
  x
}

/// One row per News item. `dedupeKey` (e.g. "podcast:<guid>", "instagram:<media id>") makes every poll
/// idempotent. Hidden items stay in the table so a re-poll never re-creates them.
model NewsItem {
  id          String    @id @default(cuid())
  dedupeKey   String    @unique
  /// NewsSource: podcast | instagram_post | instagram_story | x_post | admin_update
  source      String
  title       String?
  text        String?
  /// NewsLinks JSON (spotify, apple, instagram, x, audio).
  links       Json
  /// PodcastMeta JSON for episodes, null otherwise.
  podcast     Json?
  publishedAt DateTime
  /// Stories only (publishedAt + 24 h).
  expiresAt   DateTime?
  hiddenAt    DateTime?
  /// Dedupe-only placeholder (e.g. our own X post from a live broadcast): permanently hidden, never listed
  /// among hidden items, never restorable. It only exists so a re-poll of that dedupeKey is a no-op.
  suppressed  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  media NewsMedia[]

  @@index([hiddenAt, source, publishedAt(sort: Desc)])
  @@index([publishedAt(sort: Desc), id(sort: Desc)])
}

model NewsMedia {
  id         String  @id @default(cuid())
  itemId     String
  order      Int
  /// "image" | "video"
  kind       String
  /// Public URL served to clients (re-hosted for Instagram).
  url        String
  posterUrl  String?
  width      Int?
  height     Int?
  /// Where it came from (platform CDN URL; may expire).
  sourceUrl  String
  /// MediaStore key of `url` when re-hosted (deleted by the cleanup job for old stories).
  storageKey String?
  /// MediaStore key of `posterUrl` when re-hosted.
  posterKey  String?

  item NewsItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, order])
}

model IntegrationConfig {
  id                  IntegrationId @id
  enabled             Boolean       @default(false)
  /// Non-secret settings (string values), echoed to the admin console.
  settings            Json          @default("{}")
  /// AES-256-GCM (secrets.ts) of a JSON object of secret settings. Never logged, never returned.
  secretsEnc          String?
  /// Opaque source cursor (RSS validators, X since_id).
  cursor              String?
  accountLabel        String?
  lastRunAt           DateTime?
  lastSuccessAt       DateTime?
  lastError           String?
  itemsImported       Int           @default(0)
  tokenExpiresAt      DateTime?
  dataAccessExpiresAt DateTime?
  /// false until the first successful import: the backfill is silent (no push).
  initialSyncDone     Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model PushSubscription {
  id            String    @id @default(cuid())
  endpoint      String    @unique
  p256dh        String
  auth          String
  userId        String
  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?
  failureCount  Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// FCM / APNs tokens from the future Capacitor apps. Stored only — no sender yet.
model NativePushDevice {
  id        String   @id @default(cuid())
  /// "fcm" | "apns"
  platform  String
  token     String   @unique
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationPrefs {
  userId    String   @id
  news      Boolean  @default(true)
  fpl       Boolean  @default(true)
  live      Boolean  @default(true)
  community Boolean  @default(true)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// "Sent at most once per user per item": a row is claimed before a notification is sent.
model NotificationLog {
  id        String   @id @default(cuid())
  userId    String
  /// e.g. "news:<itemId>", "deadline:<gw>:<offset>", "gw_summary:<gw>"
  key       String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

/// Lease per background job so two instances / ticks never run the same job concurrently.
model JobLease {
  name        String    @id
  lockedUntil DateTime  @default("1970-01-01T00:00:00Z")
  lastRunAt   DateTime?
  lastOkAt    DateTime?
  lastError   String?
  /// Small job-private state (e.g. when podcast links were last re-resolved).
  state       Json?
}

// ---------- Phase 3: Community ----------

/// A fan post. Soft-deleted (deletedAt) by its author or an admin; deleted posts never reach clients.
model CommunityPost {
  id            String    @id @default(cuid())
  authorId      String
  text          String
  imageUploadId String?   @unique
  /// TeamSnapshot JSON (frozen at creation), null when no team was shared.
  teamSnapshot  Json?
  /// Denormalized counters, updated in the same transaction as the like/comment row.
  likeCount     Int       @default(0)
  commentCount  Int       @default(0)
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?
  /// User id of whoever deleted it (author or admin).
  deletedBy     String?

  author   User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  image    Upload?    @relation(fields: [imageUploadId], references: [id], onDelete: SetNull)
  comments Comment[]
  likes    PostLike[]

  @@index([deletedAt, createdAt(sort: Desc), id(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
}

model Comment {
  id        String    @id @default(cuid())
  postId    String
  authorId  String
  text      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  deletedBy String?

  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt, id])
}

model PostLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
}

/// An image uploaded for a post (re-encoded webp in the MediaStore). Unused uploads are deleted after 24 h.
model Upload {
  id          String    @id
  ownerId     String
  storageKey  String
  url         String
  width       Int
  height      Int
  contentType String
  createdAt   DateTime  @default(now())
  /// Set when attached to a post (an upload can be used once).
  usedAt      DateTime?

  owner      User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  post       CommunityPost?
  broadcasts Broadcast[]

  @@index([usedAt, createdAt])
}

enum ReportTargetKind {
  post
  comment
}

/// A user's report of a post or comment. `isOpen` is true while open and NULL once resolved: the unique
/// index then allows one OPEN report per reporter + target (NULLs are distinct in Postgres) while keeping
/// the history of resolved ones.
model Report {
  id         String           @id @default(cuid())
  targetKind ReportTargetKind
  targetId   String
  reporterId String
  /// ReportReason: spam | abuse | hate | sexual | other
  reason     String
  note       String?
  createdAt  DateTime         @default(now())
  resolvedAt DateTime?
  /// "removed" | "dismissed" | "deleted" (target deleted by its author / with its post)
  resolution String?
  resolvedBy String?
  isOpen     Boolean?         @default(true)

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([targetKind, targetId, reporterId, isOpen])
  @@index([isOpen, targetKind, targetId])
}

// ---------- Phase 4: Live broadcasts ----------

/// One admin "live update" (e.g. a goal alert) published to several targets at once. Audit trail: who sent
/// what where, with every target's result. Never deleted.
model Broadcast {
  id         String   @id @default(cuid())
  title      String?
  text       String
  /// The admin's claimed upload (News card image + X attachment).
  uploadId   String?
  /// BroadcastTarget values in the order requested (news | push | x).
  targets    String[]
  /// BroadcastTargetResult[] JSON (filled once every target has run).
  results    Json     @default("[]")
  /// The admin's user id (no FK: the history outlives an account) + their username at send time.
  sentById   String
  sentByName String
  createdAt  DateTime @default(now())

  upload Upload? @relation(fields: [uploadId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc), id(sort: Desc)])
}

// ---------- Store compliance: blocking + account deletion ----------

/// One-way, private block: the blocker no longer sees the blocked user's posts/comments or gets their notifications.
model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockerId, createdAt(sort: Desc)])
  @@index([blockedId])
}

/// MediaStore keys whose rows are already gone (e.g. a deleted account's photos). Recorded in the same transaction
/// as the row deletes; removed once the file is deleted, so the hourly cleanup retries any that failed.
model PendingMediaDelete {
  key       String   @id
  createdAt DateTime @default(now())
}
